# =====================================================================
# Trading-Firma: Beispiel-Datei  (copy to .env and fill in)
# =====================================================================
# cp .env.example .env
# .env wird NIEMALS committen / hochladen. Secrets nur lokal!

# ---------------------------------------------------------------------
# Capital.com DEMO (aktiv)
# ---------------------------------------------------------------------
CAPITAL_API_KEY=HIER_EINFUEGEN
CAPITAL_IDENTIFIER=HIER_EINFUEGEN
CAPITAL_PASSWORD=HIER_EINFUEGEN
CAPITAL_ENV=demo
CAPITAL_BASE_URL_DEMO=https://demo-api-capital.backend-capital.com/api/v1
CAPITAL_BASE_URL_LIVE=https://api-capital.backend-capital.com/api/v1

# Capital.com LIVE (leer lassen bis zur ausdruecklichen Freigabe)
CAPITAL_LIVE_API_KEY=
CAPITAL_LIVE_IDENTIFIER=
CAPITAL_LIVE_PASSWORD=

# ---------------------------------------------------------------------
# LLM fuer die Agents (Brain-Zone)
# ---------------------------------------------------------------------
# Provider: "ollama" (lokal, Standard) oder "anthropic" (Cloud/Upgrade)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# llama3.1:8b ist fuer JSON/Werkzeuge zu schwach; mindestens ein 14B-Modell, z. B. qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b

# Anthropic (nur fuehren, wenn LLM_PROVIDER=anthropic gesetzt ist)
# API-Key: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=HIER_EINFUEGEN
ANTHROPIC_MODEL=claude-opus-5-5

# Aufwand pro Agentenaufruf (low|medium|high). Agenten-Aufgaben sind kurz -> low.
ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------------
# Firma
# ---------------------------------------------------------------------
FIRM_MODE=PAPER
# Handelsstil: daytrade (Standard) = nur Intraday-Zeitrahmen, glattgestellt vor Sitzungsende, nie ueber Nacht.
# swing = zusaetzlich Stunden-Kerzen. Im Daytrading-Modus werden Swing-Urteile nicht gehandelt.
FIRM_STYLE=daytrade
# Standard-Zeitrahmen des Desks; die Forschung waehlt je Markt den besten Zeitrahmen selbst
FIRM_TRADE_RESOLUTION=MINUTE_15
# Zeitrahmen der Forschung (Daytrading: 15 und 5 Minuten). Je Markt gewinnt, was die Pruefung besteht.
FIRM_RESEARCH_RESOLUTIONS=MINUTE_15,MINUTE_5
# Desk-Takt in Sekunden (Daytrading braucht kurze Abstaende)
FIRM_TRADE_SECONDS=60
# Live-Kurse per WebSocket (0 = nur REST); aelter als N Sekunden = kein Einstieg
FIRM_STREAM=1
FIRM_QUOTE_MAX_AGE=15
# Kontostand deines LIVE-Kontos, nur fuer die Skalierungs-Leiter (Pruefung der Mindestgroessen)
FIRM_LIVE_ACCOUNT_BALANCE=200
# Forschung: automatisch beim Start ohne gueltiges Urteil, dann alle N Tage neu
FIRM_RESEARCH_DAYS=7
FIRM_RESEARCH_HISTORY_DAYS=365        # Swing (HOUR); Daytrading: FIRM_RESEARCH_HISTORY_DAYS_MINUTE_15=120
# Demo: Kandidaten mit positivem, aber nicht signifikantem Erwartungswert mit 1/4 Risiko
# handeln, um Vorwaertsdaten zu sammeln (im LIVE-Modus per Code immer aus). 0 = aus.
FIRM_DEMO_EXPLORE=1
# Alarm (DESK_IDLE -> CEO/Dashboard), wenn so viele Stunden kein Einstieg erfolgt
FIRM_IDLE_ALERT_HOURS=12
# Agenten-Rollen. FIRM_ADD_ROLES kommt immer dazu (auch bei alter FIRM_ACTIVE_ROLES-Zeile); "-" = keine.
FIRM_ACTIVE_ROLES=CEO,HeadOfResearch,RiskOfficer,MacroAnalyst,ExecutionTrader,RedTeam
FIRM_ADD_ROLES=SMCAnalyst,SMCTrader,Archivist
# Jeder Agent arbeitet mindestens alle N Minuten an der aktuellen Lage (zusaetzlich zu Ereignissen).
# Kosten: ca. (Agenten x 60/N x 24) Modellaufrufe pro Tag; Budgets in limits.toml/Rollen begrenzen das.
FIRM_AGENT_ROUTINE_MIN=30
# Mindestabstand zwischen zwei Aufgaben desselben Agenten
FIRM_AGENT_MIN_GAP_MIN=10
# Pruefung, ob das LLM erreichbar ist (ohne Tokens), Anzeige "KI VERBUNDEN" im Dashboard
FIRM_LLM_HEARTBEAT_SECONDS=60
# Lesende Capital.com-Werkzeuge fuer Agenten ueber MCP (capitalcom-mcp). 0 = aus.
FIRM_MCP=1
FIRM_DB_PATH=firm_events.db
FIRM_API_TOKEN=HIER_EINFUEGEN
# API-Fehlerlimit: so viele Fehler im Fenster -> keine neuen Orders
FIRM_MAX_API_ERRORS=10
FIRM_API_ERROR_WINDOW_MIN=30
# Schnellbremse: Equity faellt in N Minuten um X % vom Hoch -> N Minuten keine neuen Einstiege
FIRM_FAST_LOSS_PCT=1.0
FIRM_FAST_LOSS_MINUTES=60
# Kill-Kriterium Slippage: Schnitt der letzten 10 Fills in R
FIRM_MAX_AVG_SLIPPAGE_R=0.3

# Markt-Scanner: ganze Capital.com-Marktliste, beste Kandidaten (Spread/Bewegung) in den Live-Stream,
# Pruefung jede Sekunde, Signale auf jeder geschlossenen Kerze. Gehandelt wird nur die Whitelist.
FIRM_SCANNER=1
FIRM_SCAN_SECONDS=1
FIRM_SCANNER_RESOLUTION=MINUTE_5
FIRM_SCANNER_UNIVERSE=36
FIRM_SCANNER_UNIVERSE_HOURS=6
FIRM_SCANNER_RPS=2
FIRM_SCANNER_MAX_SPREAD_PCT=0.1
# So viele Scanner-Kandidaten (ausserhalb der Whitelist) prueft die Forschung zusaetzlich (0 = aus)
FIRM_RESEARCH_UNIVERSE=6

# News-Ticker (Quellen in config/news.toml, Pruefung alle 5 s, jede Quelle hoechstens alle 30-120 s)
FIRM_NEWS=1
# Fallbuch des Archivars: abgeschlossene Trades mit Kontext alle N Sekunden erfassen
FIRM_CASEBOOK_SECONDS=60

# ---------------------------------------------------------------------
# 24/7-Betrieb (Server/VPS) - Anleitung: docs/deploy_vps.md
# ---------------------------------------------------------------------
# Taegliche Sicherung (DB, Urteile, Desk-Zustand), so viele Tage behalten
FIRM_BACKUP_DIR=data/backups
FIRM_BACKUP_KEEP=14
# /health/deep meldet 503, wenn der letzte Konto-Snapshot aelter ist (Sekunden)
FIRM_HEALTH_MONEY_MAX_AGE=300

# Benachrichtigungen aufs Handy (eigener Prozess, kennt keine Broker-/LLM-Schluessel).
# ntfy: App "ntfy" installieren, langen zufaelligen Themennamen abonnieren (wer ihn kennt, liest mit!)
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
# Telegram: Bot bei @BotFather anlegen, Token hier; Chat-ID z. B. ueber @userinfobot
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# Totmannschalter (z. B. healthchecks.io, Periode 5 min, Karenz 15 min): meldet sich, wenn der Server ausfaellt
HEALTHCHECK_PING_URL=
# P&L-Betraege in Nachrichten (1 = ja). Standard aus.
NOTIFY_INCLUDE_AMOUNTS=0

# HTTPS-Zugang (docker compose --profile https): eigene (Sub-)Domain, die auf den Server zeigt
FIRM_DOMAIN=
CADDY_USER=firm
# Hash erzeugen: docker run --rm caddy:2.8 caddy hash-password   (in .env $ als $$ schreiben)
CADDY_PASSWORD_HASH=
# Bei HTTPS-Zugang zusaetzlich erlauben, z. B. https://firm.example.ch
FIRM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------------------------------------------------------------------
# Memecoin-Desk (Solana) - Anleitung: docs/memedesk.md. Standard PAPER (simuliert, echte Daten).
# ---------------------------------------------------------------------
FIRM_MEMEDESK=1
# Empfohlen fuer den Wallet-Tracker: Helius-RPC (kostenloses Konto), sonst oeffentlicher RPC (stark begrenzt)
SOLANA_RPC_URL=
# Optional: X/Twitter-Erwaehnungen fuer den Narrativ-Analysten (kostenpflichtige X-API)
X_BEARER_TOKEN=

# Dauerlauf (siehe docs/runbook.md, Abschnitt Dauerlauf-Schalter)
FIRM_KEEP_AWAKE=1
FIRM_AGENT_PARALLEL=4
FIRM_OLLAMA_AUTOSTART=1
